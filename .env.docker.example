# =============================================================================
# Scout the Rover — Docker stack configuration
# Copy to .env and fill in real values:  cp .env.docker.example .env
# Used by docker-compose.yml (env_file: .env). NEVER commit your real .env.
# =============================================================================

# --- Base image (Cosmos) -----------------------------------------------------
# NVIDIA Cosmos container; run the latest/greatest cosmos models on-GPU.
#   ref: https://github.com/NVIDIA/cosmos-framework/blob/main/docs/setup.md#docker-container
COSMOS_BASE=vllm/vllm-omni:cosmos3

# --- Ports (host side) -------------------------------------------------------
DASH_PORT=8080
SDK_PORT=8002

# --- Earth Rovers SDK / FrodoBots --------------------------------------------
# Inside the compose network services reach the SDK at http://sdk:8002
ROVER_SDK_URL=http://sdk:8002
# FrodoBots / Earth Rovers API token (from your account)
SDK_API_TOKEN=your-frodobots-sdk-token
# Your rover/bot slug
BOT_SLUG=your-bot-slug
# Optional mission to join (owner-mission)
# MISSION_SLUG=owner-mission
MAP_ZOOM_LEVEL=18
IMAGE_QUALITY=0.8
IMAGE_FORMAT=jpeg
# Headless Chrome path inside the container (do NOT change unless you know why)
CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# --- Model / inference -------------------------------------------------------
STRANDS_MODEL_ID=global.anthropic.claude-opus-4-8
STRANDS_MAX_TOKENS=120000
# AWS Bedrock (default uses boto3 chain unless a bearer token is provided)
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token
# AWS_DEFAULT_REGION=us-east-1
# OpenAI (some models + openai voice provider)
# OPENAI_API_KEY=sk-...
# Google (gemini voice provider)
# GOOGLE_API_KEY=...

# --- Hugging Face (dataset push + model pulls) ------------------------------
HUGGINGFACE_TOKEN=hf_your_token_here
HF_TOKEN=hf_your_token_here
# Pin a single growing dataset (else per-day default scout/earth-rover-mini-YYYYMMDD)
# ROVER_REPO_ID=scout/earth-rover-mini-main
ROVER_DATASET_ROOT=datasets

# --- GitHub (tools / repo automation) ---------------------------------------
GITHUB_TOKEN=ghp_your_token_here

# --- Voice (bidirectional agent) --------------------------------------------
VOICE_PROVIDER=openai
VOICE_MODEL=gpt-realtime-2
VOICE_NAME=marin

# --- Telegram bot — drive scout from your phone -----------------------------
SCOUT_TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
SCOUT_TELEGRAM_HISTORY_LIMIT=50
SCOUT_TELEGRAM_DEFAULT_CHAT_ID=your-chat-id
SCOUT_TELEGRAM_ALLOWED_USERS=your-user-id

# --- Slow-thinker loop -------------------------------------------------------
THINKER_INTERVAL=60
# THINKER_DISABLED=0
SCOUT_THINKER_DRIVE=1
THINKER_TELEGRAM_CHAT_ID=your-chat-id

# --- Dataset auto-record -----------------------------------------------------
SCOUT_AUTO_RECORD=1

# ── Optional services (used by the `all` entrypoint / compose profiles) ──────
# Toggle each on (1) or off (0) when running the single-container `all` mode.
SCOUT_ENABLE_DASHBOARD=1
SCOUT_ENABLE_TELEGRAM=1
SCOUT_ENABLE_THINKER=1
SCOUT_ENABLE_VOICE=0          # voice agent (bidirectional speech) — opt-in
SCOUT_ENABLE_REASONER=0       # co-located Cosmos vLLM reasoner in `all` mode
                              # (needed for cosmos3_reason/caption/embodied, which
                              #  call localhost:8000; loads a model on GPU)

# ── 🌌 Cosmos (NVIDIA world-model tools) ─────────────────────────────────────
# Agent tools for video/image understanding + generation. Installed in the
# image by default (base = vllm/vllm-omni:cosmos3). Disable at BUILD time with
# --build-arg INSTALL_COSMOS=0. Disable at RUN time with SCOUT_ENABLE_COSMOS=0.
SCOUT_ENABLE_COSMOS=auto      # auto | 1 | 0
#
# Reasoner server tuning (used by the `reasoner` service / `all` co-located):
C3_MODEL=nvidia/Cosmos3-Nano
C3_MAX_LEN=32768
C3_GPU_MEM=0.92
C3_ENFORCE_EAGER=false        # set true on Thor/Blackwell if PTXAS/OOM errors
# HF_TOKEN=                    # if the model repo is gated
#
# IMPORTANT — Cosmos Reasoner-server tools (cosmos3_reason / caption / embodied /
# situation / temporal / ground) call http://localhost:8000 from the package.
#   • Single-container `all` mode → set SCOUT_ENABLE_REASONER=1 (same localhost). ✅
#   • Separate `reasoner` compose service → reachable at host:8000 on the HOST,
#     but agent containers can't hit it via localhost. Use `all` co-located, or
#     run the agent with network_mode to share the reasoner's namespace.
# In-process Diffusers tools (cosmos3_text2video/image2video/text2image,
# forward/inverse_dynamics, policy) need NO server — they just work on GPU.

# ── 🔥 Warmup (preload Cosmos goodies so first call is fast) ─────────────────
SCOUT_WARMUP=1                # run warmup before agent services in `all` mode
WARMUP_GENERATOR=1            # preload the Diffusers generator pipeline (GPU)
WARMUP_GENERATE=0             # also run a tiny throwaway gen to compile kernels
WARMUP_REASONER_DOWNLOAD=0    # snapshot_download the reasoner model up-front
C3_GEN_MODEL=nvidia/Cosmos3-Nano

# ── 📂 Dataset path injection (Cosmos tools get real file paths) ─────────────
SCOUT_INJECT_DATASETS=1       # add datasets/ video+trace paths to the prompt
SCOUT_DATASETS_DIR=datasets
SCOUT_DATASET_MAX_VIDEOS=12
SCOUT_DATASET_MAX_TRACES=12

# 🔐 Auth guard (WebAuthn passkey passwordless) — seals the dashboard so only
# an enrolled admin device can drive the rover. First browser visit enrolls a
# passkey (Touch ID / Face ID / security key); after that everyone else is
# locked out. Set SCOUT_AUTH_ENABLED=false to disable (NOT recommended).
SCOUT_AUTH_ENABLED=true
# Where credentials + JWT secret live (chmod 600). Persist this across restarts.
SCOUT_AUTH_STORE=./.scout_auth.json
# Session lifetime in seconds (default 24h).
SCOUT_AUTH_TOKEN_TTL=86400
# OPTIONAL: require a one-time secret to enroll the FIRST admin passkey. This
# closes the open-enrollment window between deploy and first login. Pick any
# strong string; you only type it once, during initial setup.
# SCOUT_AUTH_BOOTSTRAP_TOKEN=change-me-once
# OPTIONAL: force the WebAuthn relying-party id / origin. Normally derived from
# the request Host/Origin. Set these when behind a reverse proxy / custom domain.
# Note: WebAuthn requires HTTPS (or http://localhost) — behind a proxy, set the
# real public origin here so passkeys bind to the right domain.
# SCOUT_AUTH_RP_ID=rover.example.com
# SCOUT_AUTH_ORIGIN=https://rover.example.com

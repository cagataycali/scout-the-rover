# Earth Rovers SDK (must be running: see README)
ROVER_SDK_URL=http://localhost:8001

# Model (pick one)
# AWS Bedrock (default — uses boto3 credential chain)
# AWS_BEARER_TOKEN_BEDROCK=
STRANDS_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Voice (bidi agent)
# openai | nova_sonic | gemini
VOICE_PROVIDER=openai
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Dataset collection (shared across all processes: main/telegram/thinker/voice)
# Pin a single growing corpus. If unset, defaults to a per-DAY dataset
# (scout/earth-rover-mini-YYYYMMDD) so same-day processes append to ONE dataset
# instead of fragmenting one-per-process.
# ROVER_REPO_ID=scout/earth-rover-mini-main
# ROVER_DATASET_ROOT=datasets

# =============================================================================
# Scout the Rover — environment configuration
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit your real .env (it holds live secrets).
# =============================================================================

# --- Earth Rovers SDK (must be running: see README / `make sdk-up`) ----------
# Local SDK server URL. NOTE: 8001 may be taken by other services (e.g. Docker);
# this project runs the SDK on 8002 by default — match ROVER_SDK_URL accordingly.
ROVER_SDK_URL='http://localhost:8002'

# API token for the Earth Rovers SDK (get from your FrodoBots/Earth Rovers account)
SDK_API_TOKEN='your-sdk-api-token-here'

# The rover/bot you control (slug from your account dashboard)
BOT_SLUG='your-bot-slug'

# Path to a Chrome/Chromium binary (used for streaming/headless capture)
# macOS:  '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'
# Linux:  '/usr/bin/google-chrome'  or  '/usr/bin/chromium-browser'
CHROME_EXECUTABLE_PATH='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'

# Map zoom level. Default 18. https://wiki.openstreetmap.org/wiki/Zoom_levels
MAP_ZOOM_LEVEL='18'

# Optional mission to join (format: owner-mission). Leave commented if unused.
# MISSION_SLUG='owner-mission'

# Image quality between 0.1 and 1.0 (default: 0.8). Recommended 0.8.
IMAGE_QUALITY='0.8'

# Image format: jpeg | png | webp (default: png). Recommended jpeg for bandwidth.
IMAGE_FORMAT='jpeg'

# --- Model (pick one) --------------------------------------------------------
# AWS Bedrock (default — uses boto3 credential chain unless a bearer token is set)
STRANDS_MODEL_ID='global.anthropic.claude-opus-4-8'
# Bedrock API key (optional; otherwise standard AWS credential chain is used)
# AWS_BEARER_TOKEN_BEDROCK='your-bedrock-bearer-token'
# Max output tokens
STRANDS_MAX_TOKENS=120000

# OpenAI (used for some models and the OpenAI voice provider)
# OPENAI_API_KEY='sk-...'

# Google (used for the gemini voice provider)
# GOOGLE_API_KEY='...'

# --- Voice (bidirectional agent) ---------------------------------------------
# Provider: openai | nova_sonic | gemini
VOICE_PROVIDER='openai'
# Realtime voice model (provider-specific)
VOICE_MODEL='gpt-realtime-2'
# Voice/persona name (provider-specific)
VOICE_NAME='marin'

# --- Text-to-Speech (SDK-side TTS, optional) ---------------------------------
# Provider: edge (free) | others
TTS_PROVIDER='edge'
# API key if your TTS provider requires one (edge does not)
TTS_API_KEY=''
# Voice id for the TTS provider
TTS_VOICE='en-US-GuyNeural'

# --- Telegram bot — drive scout from your phone ------------------------------
# Bot token from @BotFather
SCOUT_TELEGRAM_BOT_TOKEN='123456789:your-telegram-bot-token'
# How many past messages to keep in context
SCOUT_TELEGRAM_HISTORY_LIMIT='50'
# Default chat id the bot talks to
SCOUT_TELEGRAM_DEFAULT_CHAT_ID='your-chat-id'
# Comma-separated list of user ids allowed to command the bot
SCOUT_TELEGRAM_ALLOWED_USERS='your-user-id'

# --- Dataset collection ------------------------------------------------------
# Shared across all processes (main/telegram/thinker/voice).
# Pin a single growing corpus. If unset, defaults to a per-DAY dataset
# (scout/earth-rover-mini-YYYYMMDD) so same-day processes append to ONE dataset
# instead of fragmenting one-per-process.
# ROVER_REPO_ID='scout/earth-rover-mini-main'
# ROVER_DATASET_ROOT='datasets'

# --- Local SDK server port (earth-rovers-sdk/.env) ---------------------------
# Note: the SDK's own .env (earth-rovers-sdk/.env) also has an SDK_PORT.
# Keep it consistent with ROVER_SDK_URL above (this project uses 8002).

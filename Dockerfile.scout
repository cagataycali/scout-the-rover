# =============================================================================
# Scout the Rover — all-in-one container
# Base: NVIDIA Cosmos (vllm/vllm-omni:cosmos3) so we can run the latest/greatest
# Cosmos models on-GPU alongside scout's services.
#   ref: https://github.com/NVIDIA/cosmos-framework/blob/main/docs/setup.md#docker-container
#
# Bundles: rover agent, telegram listener, slow-thinker, web dashboard, and the
# earth-rovers-sdk (camera/telemetry proxy w/ headless Chrome).
#
# Build:  docker build -f Dockerfile.scout -t scout:latest .
# Run:    docker compose up -d   (see docker-compose.yml)
# =============================================================================
ARG COSMOS_BASE=vllm/vllm-omni:cosmos3
ARG INSTALL_COSMOS=1
FROM ${COSMOS_BASE}
ARG INSTALL_COSMOS=1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # earth-rovers-sdk needs a real Chrome for headless camera capture
    CHROME_EXECUTABLE_PATH=/usr/bin/google-chrome-stable \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    # 🔏 mkcert local-CA root lives in the persisted auth volume so the CA (and
    # thus phone trust) survives image rebuilds / container recreation.
    CAROOT=/app/.scout_auth_vol/mkcert-ca

# --- System deps: Google Chrome (stable) + build tooling + audio (voice) -----
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget gnupg ca-certificates git curl \
        fonts-ipafont-gothic fonts-wqy-zenhei fonts-freefont-ttf libxss1 \
        libgl1 libglib2.0-0 \
        portaudio19-dev libasound2-dev \
        libnss3-tools \
    && wget -q -O /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && (apt-get install -y /tmp/chrome.deb || (apt-get -fy install && apt-get install -y /tmp/chrome.deb)) \
    && rm -f /tmp/chrome.deb \
    # 🔏 mkcert — mint locally-trusted TLS certs (no browser warning on trusting
    # devices). Used by tls.py when DASH_TLS_MKCERT != off.
    && ARCH="$(dpkg --print-architecture)" \
    && wget -qO /usr/local/bin/mkcert "https://dl.filippo.io/mkcert/latest?for=linux/${ARCH}" \
    && chmod +x /usr/local/bin/mkcert \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Python deps (scout + sdk) ----------------------------------------------
# Copy only requirement manifests first for better layer caching.
COPY requirements.txt requirements-voice.txt /app/
COPY earth-rovers-sdk/requirements.txt /app/sdk-requirements.txt
RUN python3 -m pip install --upgrade pip \
    # ⚠️ The base image ships a CUSTOM torch build (e.g. 2.11.0+cu130) that is
    # NOT on PyPI and that vLLM's compiled _C extension is ABI-locked to. lerobot
    # hard-pins a different (PyPI) torch, which would downgrade torch and break
    # vLLM with an undefined-symbol ImportError. So:
    #   1) freeze the base torch trio in a constraints file,
    #   2) install everything EXCEPT lerobot under that constraint,
    #   3) install lerobot with --no-deps (reuse base torch) + its non-torch deps.
    && { \
         echo "torch==$(pip show torch        2>/dev/null | awk '/^Version:/{print $2}')"; \
         echo "torchvision==$(pip show torchvision 2>/dev/null | awk '/^Version:/{print $2}')"; \
         echo "torchaudio==$(pip show torchaudio  2>/dev/null | awk '/^Version:/{print $2}')"; \
         echo "fastapi==$(pip show fastapi   2>/dev/null | awk '/^Version:/{print $2}')"; \
         echo "starlette==$(pip show starlette 2>/dev/null | awk '/^Version:/{print $2}')"; \
       } | sed '/==$/d' > /tmp/torch-constraints.txt \
    && echo "📌 pinned (torch+vllm-web stack):" && cat /tmp/torch-constraints.txt \
    && export PIP_CONSTRAINT=/tmp/torch-constraints.txt \
    # scout core WITHOUT lerobot (it conflicts on torch; installed separately below)
    && grep -v '^lerobot' /app/requirements.txt > /app/requirements.core.txt \
    && pip install -r /app/requirements.core.txt \
    && pip install fastapi uvicorn websockets python-multipart hypercorn \
    # SDK pins fastapi==0.111.1 which clashes with the base image's vLLM
    # (needs 0.136.1). Drop the fastapi/starlette pins so the constraint wins;
    # the SDK runs fine on the newer fastapi.
    && sed -E '/^(fastapi|starlette)([=<>]|$)/d' /app/sdk-requirements.txt > /app/sdk-requirements.noweb.txt \
    && pip install -r /app/sdk-requirements.noweb.txt \
    # voice extras are optional; don't fail the build if a wheel is unavailable
    && (pip install -r /app/requirements-voice.txt || echo "voice extras skipped") \
    # listener deps installed SEPARATELY so a fragile voice wheel (pyaudio/
    # pywebrtc) cannot block speech-to-text for the voice listener.
    && (pip install faster-whisper webrtcvad || pip install faster-whisper || echo "listener stt extras skipped") \
    # perception subscribers: YOLO (ultralytics) + clip writing (imageio).
    && (pip install ultralytics imageio imageio-ffmpeg || echo "perception extras skipped") \
    # 🌌 Cosmos world-model tools (optional; base image already has CUDA/torch/vllm).
    && ( [ "${INSTALL_COSMOS:-1}" = "1" ] && (pip install strands-cosmos || echo "cosmos extras skipped") || echo "cosmos install disabled" ) \
    # 📦 lerobot for dataset recording — --no-deps so it reuses the base torch,
    # then pull lerobot's non-torch runtime deps (still under the torch constraint
    # so none of them can drag torch back in). Best-effort: recording is optional.
    && ( pip install --no-deps "lerobot>=0.5.1" \
         && pip install \
              accelerate av datasets deepdiff diffusers draccus einops gymnasium \
              huggingface-hub imageio jsonlines packaging pynput pyserial rerun-sdk \
              termcolor torchcodec wandb \
         || echo "lerobot install skipped (dataset recording unavailable)" ) \
    # reconcile opencv with the base image's numpy 2.x (avoid cv2 ImportError)
    && (pip uninstall -y opencv-python opencv-python-headless 2>/dev/null || true) \
    && pip install --no-cache-dir --force-reinstall "opencv-python-headless==4.11.0.86" "numpy>=2.0" \
    # sanity: torch stack still matches the base (build fails early otherwise)
    && python3 -c "import torch, torchvision, torchaudio; print('torch', torch.__version__, '| tv', torchvision.__version__, '| ta', torchaudio.__version__)"

# --- App source --------------------------------------------------------------
COPY . /app/

# Entrypoint dispatches to a chosen service via $SCOUT_SERVICE
COPY docker/entrypoint.sh /usr/local/bin/scout-entrypoint
RUN chmod +x /usr/local/bin/scout-entrypoint

# dashboard 8080, sdk 8002
EXPOSE 8080 8002

ENTRYPOINT ["/usr/local/bin/scout-entrypoint"]
CMD ["dashboard"]
